# MessPulse AI - Backend Environment Variables
# Copy this file to .env and fill in your values

# Application
APP_NAME=MessPulse AI
APP_VERSION=1.0.0
DEBUG=true
ENVIRONMENT=development

# API
API_V1_STR=/api/v1
PROJECT_NAME=MessPulse AI

# Security
SECRET_KEY=change-this-secret-key-in-production-please-make-it-long-and-random
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=7

# Database
DATABASE_URL=sqlite:///./messpulse.db
# For PostgreSQL: DATABASE_URL=postgresql+psycopg2://user:password@localhost/messpulse

# CORS
BACKEND_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# OCR (Tesseract)
TESSERACT_CMD=tesseract
OCR_ENABLED=true

# Currency
DEFAULT_CURRENCY=PKR